GROQ_API_KEY=

# Free "script" app credentials from https://www.reddit.com/prefs/apps
# (read-only app-only access — no Reddit account password used). Optional:
# if unset, the reddit collector logs a message and collects 0 rows rather
# than failing the run.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Free API key from https://console.cloud.google.com — enable "YouTube Data
# API v3" on a project, then create an API key credential. Optional: if
# unset, the youtube collector logs a message and collects 0 rows rather
# than failing the run.
YOUTUBE_API_KEY=
